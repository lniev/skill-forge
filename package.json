{
  "name": "skill-platform",
  "version": "0.0.1",
  "private": true,
  "description": "通用 AI Skill 管理平台",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:desktop": "pnpm --filter @skill-platform/desktop tauri:dev",
    "dev:server": "pnpm --filter @skill-platform/server dev",
    "build": "turbo run build",
    "build:desktop": "pnpm --filter @skill-platform/desktop build",
    "build:desktop:tauri": "pnpm --filter @skill-platform/desktop tauri:build",
    "build:server": "pnpm --filter @skill-platform/server build",
    "build:all": "turbo run build",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck"
  },
  "keywords": ["skill", "ai", "registry", "runtime", "cli"],
  "license": "MIT",
  "packageManager": "pnpm@9.0.0",
  "devDependencies": {
    "turbo": "^2.0.0"
  }
}
