{
  "name": "@skill-platform/server",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "tsx dist/index.js",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1101.0",
    "@hono/node-server": "^1.13.0",
    "@hono/zod-validator": "^0.4.0",
    "@skill-platform/api": "workspace:*",
    "@skill-platform/shared": "workspace:*",
    "bcrypt": "^5.1.1",
    "better-sqlite3": "^11.5.0",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.36.0",
    "hono": "^4.5.0",
    "jose": "^5.9.6",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.2",
    "@types/better-sqlite3": "^7.6.0",
    "@types/node": "^20.0.0",
    "drizzle-kit": "^0.28.0",
    "tsx": "^4.17.0",
    "typescript": "^5.5.0"
  }
}
